# Example environment variables for local development
# Copy to .env and edit values as needed. The Justfile will source .env when present.

SITE_BASE_URL="https://headless-voyager.vercel.app"
SITE_TITLE="the Headless Voyager's blog"
SITE_THEME="apollo"
SITE_THEME_PATH="themes/apollo"
COMPILE_SASS=true
BUILD_SEARCH_INDEX=true

# Dev server binding
PORT=1111
INTERFACE=127.0.0.1
