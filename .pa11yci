{
  "defaults": {
    "standard": "WCAG2AA",
    "level": "error",
    "timeout": 30000,
    "wait": 500,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-setuid-sandbox"]
    }
  },
  "urls": [
    "public/index.html",
    "public/about/index.html",
    "public/404.html"
  ]
}
