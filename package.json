{
  "name": "headless-voyager-blog",
  "version": "1.0.0",
  "description": "Tailwind CSS build configuration for Zola blog",
  "scripts": {
    "build:css": "tailwindcss -i ./sass/tailwind.css -o ./static/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./sass/tailwind.css -o ./static/tailwind.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "biome": "^0.3.3",
    "postcss": "^8.4.32",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0"
  }
}
