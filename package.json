{
  "name": "headless-voyager-blog",
  "version": "1.0.0",
  "description": "Tailwind CSS build configuration for Zola blog",
  "scripts": {
    "build:css": "tailwindcss -i ./sass/tailwind.css -o ./static/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./sass/tailwind.css -o ./static/tailwind.css --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.0"
  },
  "overrides": {
    "braces": ">=3.0.3",
    "lodash": ">=4.17.21",
    "form-data": ">=4.0.0",
    "qs": ">=6.16.0",
    "uuid": ">=11.1.1",
    "tough-cookie": ">=4.1.3",
    "brace-expansion": ">=1.1.21"
  }
}
